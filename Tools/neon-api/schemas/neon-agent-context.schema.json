{
  "$id": "https://schemas.mtasa-neon.com/agent/neon-agent-context-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiIndex": {"$ref": "#/$defs/reference"},
    "catalogue": {
      "additionalProperties": false,
      "properties": {
        "catalogueVersion": {"format": "semver", "type": "string"},
        "engine": {
          "additionalProperties": false,
          "properties": {"family": {"minLength": 1, "type": "string"}, "version": {"format": "semver", "type": "string"}},
          "required": ["family", "version"],
          "type": "object"
        },
        "schemaVersion": {"format": "semver", "type": "string"},
        "sha256": {"format": "sha256", "type": "string"},
        "symbols": {"minimum": 0, "type": "integer"}
      },
      "required": ["schemaVersion", "catalogueVersion", "engine", "sha256", "symbols"],
      "type": "object"
    },
    "files": {"items": {"$ref": "#/$defs/file"}, "type": "array"},
    "guidance": {
      "additionalProperties": false,
      "properties": {
        "discover": {"minLength": 1, "type": "string"},
        "resolve": {"minLength": 1, "type": "string"},
        "rule": {"minLength": 1, "type": "string"},
        "validate": {"minLength": 1, "type": "string"}
      },
      "required": ["validate", "resolve", "discover", "rule"],
      "type": "object"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "additionalProperties": false,
          "properties": {
            "maximumVersionExclusive": {"format": "semver", "type": "string"},
            "minimumVersion": {"format": "semver", "type": "string"}
          },
          "required": ["minimumVersion", "maximumVersionExclusive"],
          "type": "object"
        },
        "name": {"minLength": 1, "type": "string"},
        "profile": {"enum": ["mta-upstream", "neon-server", "neon-client", "neon-pair", "neon-multiclient"], "type": "string"},
        "sha256": {"format": "sha256", "type": "string"}
      },
      "required": ["name", "profile", "engine", "sha256"],
      "type": "object"
    },
    "projectApi": {"$ref": "#/$defs/reference"},
    "schemaVersion": {"format": "semver", "type": "string"},
    "usedApiIds": {"items": {"format": "stable-id", "type": "string"}, "type": "array", "uniqueItems": true},
    "validation": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {"items": {"$ref": "#/$defs/diagnostic"}, "type": "array"},
        "status": {"const": "pass", "type": "string"},
        "summary": {
          "additionalProperties": false,
          "properties": {
            "apiRequirements": {"minimum": 0, "type": "integer"},
            "errors": {"const": 0, "type": "integer"},
            "files": {"minimum": 0, "type": "integer"},
            "resources": {"minimum": 0, "type": "integer"},
            "warnings": {"minimum": 0, "type": "integer"}
          },
          "required": ["errors", "warnings", "resources", "files", "apiRequirements"],
          "type": "object"
        }
      },
      "required": ["status", "summary", "diagnostics"],
      "type": "object"
    }
  },
  "required": ["schemaVersion", "project", "catalogue", "projectApi", "apiIndex", "files", "usedApiIds", "validation", "guidance"],
  "type": "object",
  "$defs": {
    "file": {
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["project", "meta", "manifest", "lua", "asset", "binary"], "type": "string"},
        "owner": {"minLength": 1, "type": "string"},
        "path": {"format": "relative-path", "type": "string"},
        "sha256": {"format": "sha256", "type": "string"},
        "side": {"enum": ["client", "server", "shared"], "type": "string"},
        "size": {"minimum": 0, "type": "integer"}
      },
      "required": ["path", "kind", "owner", "size", "sha256"],
      "type": "object"
    },
    "diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {"pattern": "^[A-Z][A-Z0-9_]+$", "type": "string"},
        "line": {"minimum": 1, "type": "integer"},
        "message": {"minLength": 1, "type": "string"},
        "path": {"minLength": 1, "type": "string"},
        "severity": {"enum": ["error", "warning"], "type": "string"},
        "side": {"enum": ["client", "server", "shared"], "type": "string"},
        "symbol": {"pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$", "type": "string"}
      },
      "required": ["code", "severity", "message", "path"],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "path": {"format": "relative-path", "type": "string"},
        "sha256": {"format": "sha256", "type": "string"},
        "symbols": {"minimum": 0, "type": "integer"}
      },
      "required": ["path", "sha256", "symbols"],
      "type": "object"
    }
  }
}
