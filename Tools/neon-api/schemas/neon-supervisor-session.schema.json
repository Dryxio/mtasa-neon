{
  "$id": "https://schemas.mtasa-neon.com/agent/neon-supervisor-session-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {"enum": ["knowledge.read", "project.read", "runtime.observe", "diagnostics.read", "artifacts.read", "resource.lifecycle", "scenario.execute", "client.launch"], "type": "string"},
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "catalogue": {"$ref": "#/$defs/input"},
    "client": {
      "additionalProperties": false,
      "properties": {
        "connectUri": {"pattern": "^mtasa://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$", "type": "string"},
        "executable": {"enum": ["Multi Theft Auto.exe", "mta-client"], "type": "string"},
        "executableSha256": {"format": "sha256", "type": "string"},
        "root": {"maxLength": 1024, "minLength": 1, "type": "string"}
      },
      "required": ["root", "executable", "executableSha256", "connectUri"],
      "type": "object"
    },
    "createdAt": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "expiresAt": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "driver": {
      "additionalProperties": false,
      "properties": {
        "executable": {"enum": ["MTA Server64.exe", "MTA Server.exe", "mta-server64", "mta-server"], "type": "string"},
        "executableSha256": {"format": "sha256", "type": "string"},
        "guardianPid": {"minimum": 1, "type": "integer"},
        "kind": {"const": "mta-server-stdio", "type": "string"},
        "pid": {"minimum": 1, "type": "integer"},
        "root": {"maxLength": 1024, "minLength": 1, "type": "string"}
      },
      "required": ["kind", "root", "executable", "executableSha256", "pid", "guardianPid"],
      "type": "object"
    },
    "pid": {"minimum": 1, "type": "integer"},
    "profile": {"enum": ["mta-upstream", "neon-server", "neon-client", "neon-pair", "neon-multiclient"], "type": "string"},
    "project": {"$ref": "#/$defs/input"},
    "probe": {
      "additionalProperties": false,
      "properties": {
        "challenge": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "expectedClients": {"maximum": 8, "minimum": 1, "type": "integer"},
        "report": {"maxLength": 256, "minLength": 1, "type": "string"},
        "resource": {"const": "neon-agent-probe", "type": "string"},
        "sourceSha256": {"format": "sha256", "type": "string"}
      },
      "required": ["resource", "sourceSha256", "challenge", "expectedClients", "report"],
      "type": "object"
    },
    "schemaVersion": {"format": "semver", "maxLength": 64, "type": "string"},
    "sessionId": {"format": "stable-id", "maxLength": 128, "type": "string"},
    "snapshot": {
      "additionalProperties": false,
      "properties": {"path": {"format": "relative-path", "type": "string"}},
      "required": ["path"],
      "type": "object"
    },
    "state": {"enum": ["active", "closed", "expired"], "type": "string"},
    "token": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "transport": {
      "additionalProperties": false,
      "properties": {
        "host": {"const": "127.0.0.1", "type": "string"},
        "kind": {"const": "loopback-tcp", "type": "string"},
        "port": {"maximum": 65535, "minimum": 1, "type": "integer"}
      },
      "required": ["kind", "host", "port"],
      "type": "object"
    }
  },
  "required": ["schemaVersion", "sessionId", "state", "profile", "createdAt", "expiresAt", "capabilities", "project", "catalogue", "snapshot", "transport", "pid"],
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "capabilities": {
          "allOf": [
            {"contains": {"const": "client.launch"}, "minContains": 1, "maxContains": 1},
            {"contains": {"const": "resource.lifecycle"}, "minContains": 1, "maxContains": 1}
          ]
        },
        "profile": {"enum": ["neon-pair", "neon-multiclient"]}
      },
      "required": ["client", "probe", "driver"],
      "oneOf": [
        {
          "properties": {
            "profile": {"const": "neon-pair"},
            "probe": {"properties": {"expectedClients": {"const": 1}}}
          }
        },
        {
          "properties": {
            "profile": {"const": "neon-multiclient"},
            "probe": {"properties": {"expectedClients": {"const": 2}}}
          }
        }
      ]
    },
    {
      "properties": {
        "capabilities": {
          "items": {"enum": ["knowledge.read", "project.read", "runtime.observe", "diagnostics.read", "artifacts.read", "resource.lifecycle", "scenario.execute"]}
        }
      },
      "not": {"anyOf": [{"required": ["client"]}, {"required": ["probe"]}]}
    }
  ],
  "$defs": {
    "input": {
      "additionalProperties": false,
      "properties": {
        "contractSha256": {"format": "sha256", "type": "string"},
        "path": {"format": "relative-path", "type": "string"},
        "sha256": {"format": "sha256", "type": "string"}
      },
      "required": ["path", "sha256"],
      "type": "object"
    }
  }
}
