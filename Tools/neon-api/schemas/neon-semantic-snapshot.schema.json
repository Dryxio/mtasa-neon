{
  "$id": "https://schemas.mtasa-neon.com/agent/neon-semantic-snapshot-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {"format": "sha256", "type": "string"},
    "elements": {"items": {"$ref": "#/$defs/namedDocument"}, "type": "array"},
    "events": {"items": {"$ref": "#/$defs/event"}, "type": "array"},
    "functions": {"items": {"$ref": "#/$defs/function"}, "type": "array"},
    "schemaVersion": {"format": "semver", "type": "string"},
    "sources": {
      "additionalProperties": false,
      "properties": {
        "neonWiki": {"$ref": "#/$defs/importSource"},
        "upstreamWiki": {"$ref": "#/$defs/importSource"}
      },
      "required": ["upstreamWiki", "neonWiki"],
      "type": "object"
    },
    "types": {"items": {"$ref": "#/$defs/namedDocument"}, "type": "array"}
  },
  "required": ["schemaVersion", "sources", "functions", "events", "elements", "types", "digest"],
  "type": "object",
  "$defs": {
    "contract": {
      "additionalProperties": false,
      "properties": {
        "description": {"minLength": 1, "type": "string"},
        "example": {"minLength": 1, "type": "string"},
        "notes": {"items": {"type": "string"}, "type": "array"},
        "oop": {"$ref": "#/$defs/oop"},
        "oopMethods": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
        "parameters": {"items": {"$ref": "#/$defs/parameter"}, "type": "array"},
        "requiresReview": {"type": "boolean"},
        "returnDescription": {"minLength": 1, "type": "string"},
        "returns": {"items": {"$ref": "#/$defs/return"}, "type": "array"},
        "side": {"enum": ["client", "server", "shared"], "type": "string"},
        "signature": {"minLength": 1, "type": "string"},
        "sourceCommit": {"minLength": 7, "type": "string"},
        "sourcePath": {"format": "relative-path", "type": "string"},
        "testResource": {"format": "relative-path", "type": "string"},
        "version": {"$ref": "#/$defs/version"}
      },
      "required": ["side", "parameters", "returns", "requiresReview", "sourcePath"],
      "type": "object"
    },
    "event": {
      "additionalProperties": false,
      "properties": {
        "canceling": {"minLength": 1, "type": "string"},
        "description": {"minLength": 1, "type": "string"},
        "name": {"minLength": 1, "type": "string"},
        "parameters": {"items": {"$ref": "#/$defs/parameter"}, "type": "array"},
        "provider": {"enum": ["mta"], "type": "string"},
        "requiresReview": {"type": "boolean"},
        "side": {"enum": ["client", "server", "shared"], "type": "string"},
        "sourceElement": {
          "additionalProperties": false,
          "properties": {
            "description": {"minLength": 1, "type": "string"},
            "type": {"minLength": 1, "type": "string"}
          },
          "type": "object"
        },
        "sourcePath": {"format": "relative-path", "type": "string"},
        "version": {"$ref": "#/$defs/version"}
      },
      "required": ["name", "provider", "side", "parameters", "requiresReview", "sourcePath"],
      "type": "object"
    },
    "function": {
      "additionalProperties": false,
      "properties": {
        "category": {"minLength": 1, "type": "string"},
        "contracts": {"items": {"$ref": "#/$defs/contract"}, "minItems": 1, "type": "array"},
        "extension": {"type": "boolean"},
        "name": {"minLength": 1, "type": "string"},
        "provider": {"enum": ["mta", "neon"], "type": "string"}
      },
      "required": ["name", "provider", "contracts"],
      "type": "object"
    },
    "importSource": {
      "additionalProperties": false,
      "properties": {
        "license": {"minLength": 1, "type": "string"},
        "repository": {"pattern": "^https://.*$", "type": "string"},
        "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
      },
      "required": ["repository", "revision", "license"],
      "type": "object"
    },
    "namedDocument": {
      "additionalProperties": false,
      "properties": {
        "description": {"minLength": 1, "type": "string"},
        "name": {"minLength": 1, "type": "string"},
        "oopOnlyMethods": {"items": {"$ref": "#/$defs/oopMethod"}, "type": "array"},
        "provider": {"enum": ["mta"], "type": "string"},
        "redirect": {"minLength": 1, "type": "string"},
        "requiresReview": {"type": "boolean"},
        "sourcePath": {"format": "relative-path", "type": "string"}
      },
      "required": ["name", "provider", "requiresReview", "sourcePath"],
      "type": "object"
    },
    "oop": {
      "additionalProperties": false,
      "properties": {
        "constructorClass": {"minLength": 1, "type": "string"},
        "element": {"minLength": 1, "type": "string"},
        "method": {"minLength": 1, "type": "string"},
        "staticClass": {"minLength": 1, "type": "string"}
      },
      "type": "object"
    },
    "oopMethod": {
      "additionalProperties": false,
      "properties": {
        "name": {"minLength": 1, "type": "string"},
        "parameters": {"items": {"$ref": "#/$defs/parameter"}, "type": "array"},
        "signature": {"minLength": 1, "type": "string"}
      },
      "required": ["name", "parameters"],
      "type": "object"
    },
    "parameter": {
      "additionalProperties": false,
      "properties": {
        "default": {"type": "string"},
        "description": {"minLength": 1, "type": "string"},
        "name": {"minLength": 1, "type": "string"},
        "optional": {"type": "boolean"},
        "type": {"minLength": 1, "type": "string"}
      },
      "required": ["name", "type", "optional"],
      "type": "object"
    },
    "return": {
      "additionalProperties": false,
      "properties": {
        "description": {"minLength": 1, "type": "string"},
        "name": {"minLength": 1, "type": "string"},
        "type": {"minLength": 1, "type": "string"}
      },
      "required": ["type"],
      "type": "object"
    },
    "version": {
      "additionalProperties": false,
      "properties": {
        "added": {"type": "string"},
        "deprecated": {"type": "string"},
        "removed": {"type": "string"},
        "replacement": {"type": "string"},
        "updated": {"type": "string"}
      },
      "type": "object"
    }
  }
}
