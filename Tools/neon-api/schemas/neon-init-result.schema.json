{
  "$id": "https://schemas.mtasa-neon.com/agent/neon-init-result-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agentGuide": {"const": "NEON_AGENT.md"},
    "catalogue": {"const": ".neon-tooling/neon-api.json"},
    "command": {"const": "init"},
    "created": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "diagnostics": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "code": {"pattern": "^[A-Z][A-Z0-9_]+$", "type": "string"},
          "message": {"maxLength": 1024, "minLength": 1, "type": "string"},
          "path": {"maxLength": 512, "type": "string"},
          "severity": {"enum": ["error", "warning"], "type": "string"}
        },
        "required": ["code", "severity", "message", "path"],
        "type": "object"
      },
      "type": "array"
    },
    "preserved": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "project": {"const": "neon.project.json"},
    "resources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {"pattern": "^[A-Za-z0-9_.-]+$", "type": "string"},
          "path": {"format": "relative-path", "type": "string"}
        },
        "required": ["name", "path"],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {"const": "1.0.0"},
    "status": {"enum": ["pass", "fail"], "type": "string"},
    "summary": {
      "additionalProperties": false,
      "properties": {
        "contextReady": {"type": "boolean"},
        "errors": {"minimum": 0, "type": "integer"},
        "resources": {"minimum": 0, "type": "integer"},
        "warnings": {"minimum": 0, "type": "integer"}
      },
      "required": ["errors", "warnings", "resources", "contextReady"],
      "type": "object"
    }
  },
  "required": ["schemaVersion", "command", "status", "summary", "diagnostics", "project", "catalogue", "agentGuide", "resources", "created", "preserved"],
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "status": {"const": "pass"},
        "summary": {"properties": {"contextReady": {"const": true}, "errors": {"const": 0}}}
      }
    },
    {
      "properties": {
        "status": {"const": "fail"},
        "summary": {"properties": {"errors": {"minimum": 1}}}
      }
    }
  ]
}
