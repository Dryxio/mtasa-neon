# Public HTTPS origin of this service. The callback below must be registered
# verbatim in the Discord Developer Portal.
PUBLIC_BASE_URL=https://identity.example.com
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://neon_identity:change-me@127.0.0.1:5432/neon_identity
DATABASE_SSL=false

DISCORD_CLIENT_ID=replace-with-application-id
DISCORD_CLIENT_SECRET=replace-with-client-secret
DISCORD_REDIRECT_URI=https://identity.example.com/v1/auth/discord/callback

# Optional global policy hook. Leave all three blank for platform-wide linking.
# A server such as Blitz should normally apply its own membership rule when a
# ticket is requested, rather than making every Neon account join its guild.
DISCORD_REQUIRED_GUILD_ID=
DISCORD_REQUIRED_ROLE_IDS=
DISCORD_BOT_TOKEN=
DISCORD_REQUIRE_COMPLETED_SCREENING=true

NEON_ISSUER=https://identity.example.com
# Static V1 registry. The native client must send the actual endpoint it is
# joining; tickets are never signed for a pair absent from this JSON object.
NEON_SERVER_REGISTRY='{"blitz-production":["203.0.113.10:22003","203.0.113.11:22003"]}'
NEON_TICKET_KEY_ID=neon-identity-v1-2026-08
# A private Ed25519 JWK encoded as one compact JSON string. Never ship it in the
# client or commit it. Generate one with: npm run generate-key
NEON_TICKET_PRIVATE_JWK='{"kty":"OKP","crv":"Ed25519","x":"replace","d":"replace"}'

# Exactly 32 random bytes, base64url encoded. This encrypts the short-lived
# OAuth state/PKCE cookie and must remain backend-only.
OAUTH_COOKIE_KEY=replace-with-base64url-encoded-32-bytes
OAUTH_FLOW_TTL_SECONDS=300
SESSION_TTL_SECONDS=2592000
TICKET_TTL_SECONDS=45
TRUST_PROXY=false
